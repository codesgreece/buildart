# Email notifications for the contact / quote form
# Destination inbox (defaults to buildartgr@gmail.com)
CONTACT_TO_EMAIL=buildartgr@gmail.com

# Option A — easiest for Gmail (recommended to start):
# 1) Go to https://web3forms.com
# 2) Create a key for buildartgr@gmail.com
# 3) Paste it below
WEB3FORMS_ACCESS_KEY=

# Option B — Resend (https://resend.com)
# RESEND_API_KEY=
# Optional custom from-address after domain verification:
# CONTACT_FROM_EMAIL=BUILDART <noreply@yourdomain.com>
